PORT=3001
DATABASE_URL=postgresql://jiankai:jiankai123@localhost:5433/jiankai_quotation
# 应用与数据库统一使用北京时间（Asia/Shanghai）
TZ=Asia/Shanghai
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173
# 生产环境：构建前端后由后端托管静态资源（npm run build:all && npm run start:prod）
STATIC_DIR=../frontend/dist
# JWT（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=8h
# 初始化管理员密码（npm run db:seed-auth），默认 admin123
ADMIN_INITIAL_PASSWORD=admin123
