{
  "name": "jiankai-quotation-system",
  "version": "1.0.0",
  "private": true,
  "description": "柬凯内部管理系统 - 报价模块",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "build:all": "cd backend && npm run build && cd ../frontend && npm run build",
    "start:prod": "cd backend && npm start",
    "test": "cd backend && npm test",
    "db:init": "cd backend && npm run db:init",
    "db:seed": "cd backend && npm run db:seed",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:seed-scheduling": "cd backend && npm run db:seed-scheduling",
    "db:seed-auth": "cd backend && npm run db:seed-auth",
    "db:prune-shipping": "cd backend && npm run db:prune-shipping"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "all": "^0.0.0"
  }
}
